PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dsa_revision_tracker

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Optional. Without a key the app uses the simpler offline feedback.
# Free key: https://aistudio.google.com  (never commit a real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest